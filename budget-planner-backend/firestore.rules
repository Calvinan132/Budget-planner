rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Users collection: Only the owner can read/write their user profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 2. Monthly Plans collection: Doc ID format is ${userId}_${year}_${month}
    match /monthly_plans/{planId} {
      allow read, write: if request.auth != null && (
        resource == null || resource.data.userId == request.auth.uid || planId.matches('^' + request.auth.uid + '_.*')
      );
    }

    // 3. Daily Logs collection: Doc ID format is ${userId}_${date}
    match /daily_logs/{logId} {
      allow read, write: if request.auth != null && (
        resource == null || resource.data.userId == request.auth.uid || logId.matches('^' + request.auth.uid + '_.*')
      );
    }

    // 4. Flow Configs: Visual Flow diagrams for Admin & Monitoring Dashboard
    match /flow_configs/{configId} {
      allow read, write: if true; // In production: if request.auth != null
    }

    // 5. Node Statuses: Real-time status for each monitored node
    match /node_statuses/{nodeId} {
      allow read, write: if true; // Backend Admin SDK bypasses rules; Web monitor & Flutter client can sync
    }

    // 6. Node Logs: TTL 7-day error logs & health check traces
    match /node_logs/{logId} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
