# Server Configuration
PORT=5000
NODE_ENV=development

# Firebase Admin SDK Configuration
# Option 1: Service Account JSON File Path
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option 2: Individual Environment Variables (useful for cloud deployments like Heroku/Vercel/Render)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Development & Testing Flags
# Set DEV_AUTH_BYPASS=true to enable testing endpoints locally without requiring a valid Firebase Auth token.
DEV_AUTH_BYPASS=false
